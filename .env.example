# ── Copy to .env.production and fill before running scripts/launch-production.sh ──

# Frontend (Vite — prefix VITE_)
VITE_MANIFEST_URL=https://ton-launchpad-miniapp.vercel.app/tonconnect-manifest.json
VITE_TWA_RETURN_URL=https://t.me/YourBot/yourapp
VITE_FACTORY_ADDRESS=PENDING_DEPLOY
VITE_TONAPI_BASE=https://tonapi.io
VITE_NETWORK=mainnet

# Server (Vercel — no VITE_ prefix)
TELEGRAM_BOT_TOKEN=
JWT_SECRET=
PLATFORM_TREASURY_ADDRESS=
FACTORY_ADDRESS=
TONAPI_KEY=

# Contract deploy (LOCAL ONLY — never commit)
DEPLOY_MNEMONIC=
TONCENTER_API_KEY=

# Optional — for launch script
VERCEL_PROD_URL=https://ton-launchpad-miniapp.vercel.app
