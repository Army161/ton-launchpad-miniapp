# ── Template. Copy to .env.testnet / .env.production (both gitignored) and fill locally. ──
# Never commit a filled copy. Never paste a secret into chat. See docs/ENVIRONMENT.md.
# Check with: node scripts/validate-env.ts <deploy-testnet|deploy-mainnet|production> [--network]

# Public client config (VITE_* is shipped to every browser: never put a secret here)
VITE_MANIFEST_URL=https://ton-launchpad-miniapp.vercel.app/tonconnect-manifest.json
VITE_TWA_RETURN_URL=https://t.me/YourBot/yourapp
VITE_FACTORY_ADDRESS=PENDING_DEPLOY
VITE_TONAPI_BASE=https://tonapi.io
VITE_NETWORK=mainnet

# Server only (Vercel → Settings → Environment Variables)
TELEGRAM_BOT_TOKEN=
JWT_SECRET=
PLATFORM_TREASURY_ADDRESS=
FACTORY_ADDRESS=
TONCENTER_API_KEY=
# TON_NETWORK=testnet            # optional; overrides VITE_NETWORK for the API
# BLOB_READ_WRITE_TOKEN=         # set by Vercel when Blob storage is enabled (image upload)

# Local deploy / keeper only (never in Vercel, never committed)
DEPLOY_MNEMONIC=
DEPLOY_WALLET_VERSION=v5r1
LIQUIDITY_MANAGER_ADDRESS=
# KEEPER_MNEMONIC=               # optional; defaults to DEPLOY_MNEMONIC
# Set to yes only after the founder wrote "MAINNET GO-LIVE APPROVED"
MAINNET_GO_LIVE_APPROVED=

# Launch script output
VERCEL_PROD_URL=https://ton-launchpad-miniapp.vercel.app
