# ── Template. Copy to .env.testnet / .env.production (both gitignored) and fill locally. ──
# Never commit a filled copy. Never paste a secret into chat. See docs/ENVIRONMENT.md.
# Check with: node scripts/validate-env.ts <deploy-testnet|deploy-mainnet|production> [--network]

# Public client config (VITE_* is shipped to every browser: never put a secret here)
VITE_MANIFEST_URL=https://ton-launchpad-miniapp.vercel.app/tonconnect-manifest.json
VITE_TWA_RETURN_URL=https://t.me/YourBot/yourapp
VITE_FACTORY_ADDRESS=PENDING_DEPLOY
VITE_TONAPI_BASE=https://tonapi.io
VITE_NETWORK=mainnet
# VITE_FACTORY_DEPLOY_PAGE=on    # only on the preview used for the one-time wallet-approved factory deploy

# Server only (Vercel → Settings → Environment Variables)
TELEGRAM_BOT_TOKEN=
JWT_SECRET=
PLATFORM_TREASURY_ADDRESS=
FACTORY_ADDRESS=
TONCENTER_API_KEY=
# TON_NETWORK=testnet            # optional; overrides VITE_NETWORK for the API
# BLOB_READ_WRITE_TOKEN=         # set by Vercel when Blob storage is enabled (image upload)
# IMAGE_GENERATION=on            # AI token images through Vercel AI Gateway (ADR-012); needs Blob storage
# IMAGE_GEN_USER_DAILY_LIMIT=5   # free images per Telegram user per UTC day
# IMAGE_GEN_GLOBAL_DAILY_LIMIT=50  # free images for everyone per UTC day (max 1000)
# IMAGE_GEN_MODELS=              # optional: comma-separated model ids to offer; default is all four
# AI_GATEWAY_API_KEY=            # optional secret: on Vercel the deployment's OIDC token is used instead

# Local deploy / keeper only (never in Vercel, never committed)
DEPLOY_MNEMONIC=
DEPLOY_WALLET_VERSION=v5r1
LIQUIDITY_MANAGER_ADDRESS=
# STON.fi v2 constant-product router that graduated tokens seed (ADR-009).
# Mainnet: the deploy script reads its pTON wallet from the STON.fi API.
# Testnet (no STON.fi API): set STON_PTON_MASTER_ADDRESS; the wallet is asked on-chain.
# Testnet v2.1 values (docs.ston.fi v2 swap guide): router kQALh-JBBIKK7gr0o4AVf9JZnEsFndqO0qTCyT-D-yBsWk0v,
# pTON master kQACS30DNoUQ7NfApPvzh7eBmSZ9L4ygJ-lkNWtba8TQT-Px
STON_ROUTER_ADDRESS=
STON_PTON_MASTER_ADDRESS=
STON_PTON_WALLET_ADDRESS=
# KEEPER_MNEMONIC=               # optional; defaults to DEPLOY_MNEMONIC
# Set to yes only after the founder wrote "MAINNET GO-LIVE APPROVED"
MAINNET_GO_LIVE_APPROVED=

# Launch script output
VERCEL_PROD_URL=https://ton-launchpad-miniapp.vercel.app
# Links the Vercel CLI to the project without `vercel link` (IDs, not secrets).
# VERCEL_ORG_ID=team_...
# VERCEL_PROJECT_ID=prj_...
