{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "api",
    "scripts/**/*.ts",
    "tests"
  ]
}
