(slice, slice, slice, (slice, slice), int) $LaunchpadFactory$_contract_init(slice $owner, slice $treasury, slice $liquidityManager, (slice, slice) $dex) impure inline {
    var (($dex'router, $dex'ptonWallet)) = $dex;
    var (($self'owner, $self'treasury, $self'liquidityManager, ($self'dex'router, $self'dex'ptonWallet), $self'launchCount)) = (null(), null(), null(), null(), null());
    $self'owner = $owner;
    $self'treasury = $treasury;
    $self'liquidityManager = $liquidityManager;
    ($self'dex'router, $self'dex'ptonWallet) = ($dex'router, $dex'ptonWallet);
    $self'launchCount = 0;
    return ($self'owner, $self'treasury, $self'liquidityManager, ($self'dex'router, $self'dex'ptonWallet), $self'launchCount);
}

