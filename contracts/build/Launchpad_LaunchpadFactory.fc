builder $BondingCurve$init$_store(builder build_0, (slice, slice, slice, slice, slice) v) inline {
    var (v'creator, v'platformTreasury, v'jettonMaster, v'name, v'symbol) = v;
    build_0 = build_0.store_slice(v'creator);
    build_0 = build_0.store_slice(v'platformTreasury);
    build_0 = build_0.store_slice(v'jettonMaster);
    build_0 = build_0.store_builder_ref(begin_cell().store_slice(v'name));
    build_0 = build_0.store_builder_ref(begin_cell().store_slice(v'symbol));
    return build_0;
}

cell $BondingCurve$_child_get_code() impure asm """
    B{} B>boc PUSHREF
""";

(cell, cell) $BondingCurve$_init_child(slice $creator, slice $platformTreasury, slice $jettonMaster, slice $name, slice $symbol) inline_ref {
    ;; Build init code cell

    ;; Contract Code: BondingCurve
    cell init_code = $BondingCurve$_child_get_code();


    builder b = begin_cell();
    b = b.store_int(false, 1);
    b = $BondingCurve$init$_store(b, ($creator, $platformTreasury, $jettonMaster, $name, $symbol));
    return (init_code, b.end_cell());
}

