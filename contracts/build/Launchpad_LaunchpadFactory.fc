;;

builder $LaunchpadFactory$_store(builder build_0, (slice, slice, int, int) v) inline {
    var (v'owner, v'platformTreasury, v'launchCount, v'launchFee) = v;
    build_0 = build_0.store_slice(v'owner);
    build_0 = build_0.store_slice(v'platformTreasury);
    build_0 = build_0.store_uint(v'launchCount, 32);
    build_0 = build_0.store_varuint16(v'launchFee);
    return build_0;
}

(slice, ((slice, slice, int, int))) $LaunchpadFactory$_load(slice sc_0) inline {
    var v'owner = sc_0~load_msg_addr();
    var v'platformTreasury = sc_0~load_msg_addr();
    var v'launchCount = sc_0~load_uint(32);
    var v'launchFee = sc_0~load_varuint16();
    return (sc_0, (v'owner, v'platformTreasury, v'launchCount, v'launchFee));
}

(slice, ((slice, slice))) $LaunchpadFactory$init$_load(slice sc_0) inline {
    var v'owner = sc_0~load_msg_addr();
    var v'platformTreasury = sc_0~load_msg_addr();
    return (sc_0, (v'owner, v'platformTreasury));
}

(slice, slice, int, int) $LaunchpadFactory$_contract_load() impure inline {
    slice $sc = get_data().begin_parse();
    int $loaded = $sc~load_int(1);
    if ($loaded) {
        return $sc~$LaunchpadFactory$_load();
    }
    else {
        (slice $owner, slice $platformTreasury) = $sc~$LaunchpadFactory$init$_load();
        $sc.end_parse();
        return $LaunchpadFactory$_contract_init($owner, $platformTreasury);
    }
}

() $LaunchpadFactory$_contract_store((slice, slice, int, int) v) impure inline {
    builder b = begin_cell();
    b = b.store_int(true, 1);
    b = $LaunchpadFactory$_store(b, v);
    set_data(b.end_cell());
}

;;
;; Contract LaunchpadFactory functions
;;

(slice, slice, int, int) $LaunchpadFactory$_contract_init(slice $owner, slice $platformTreasury) impure inline {
    var (($self'owner, $self'platformTreasury, $self'launchCount, $self'launchFee)) = (null(), null(), null(), null());
    $self'owner = $owner;
    $self'platformTreasury = $platformTreasury;
    $self'launchCount = 0;
    $self'launchFee = 50000000;
    return ($self'owner, $self'platformTreasury, $self'launchCount, $self'launchFee);
}

((slice, slice, int, int), (slice, slice, int, int, int, int)) $LaunchpadFactory$_fun_get_factory_info((slice, slice, int, int) $self) impure inline_ref {
    var (($self'owner, $self'platformTreasury, $self'launchCount, $self'launchFee)) = $self;
    var $fresh$ret_14 = $FactoryInfo$_constructor_owner_platformTreasury_launchCount_launchFee_graduationTarget_tradeFeeBps($self'owner, $self'platformTreasury, $self'launchCount, $self'launchFee, 1500000000000, 200);
    return (($self'owner, $self'platformTreasury, $self'launchCount, $self'launchFee), $fresh$ret_14);
}

;;
;; Get methods of a Contract LaunchpadFactory
;;

_ %get_factory_info() method_id(112759) {
    var self = $LaunchpadFactory$_contract_load();
    var res = self~$LaunchpadFactory$_fun_get_factory_info();
    return $FactoryInfo$_to_external(res);
}

;;
;; Routing of a Contract LaunchpadFactory
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'owner, $self'platformTreasury, $self'launchCount, $self'launchFee) = $LaunchpadFactory$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    var op = in_msg~load_opcode_internal();
    ;; Receive CreateToken message
    if (op == 0x1) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'name = in_msg~load_ref().begin_parse();
        var $msg'symbol = in_msg~load_ref().begin_parse();
        slice sc_1 = in_msg~load_ref().begin_parse();
        var $msg'imageUri = sc_1~load_ref().begin_parse();
        var $msg'description = sc_1~load_ref().begin_parse();
        var $msg'telegramLink = sc_1~load_ref().begin_parse();
        var $msg'initialBuyTon = sc_1~load_varuint16();
        var ($ctx'bounceable, $ctx'sender, $ctx'value, $ctx'raw) = __tact_context_get();
        throw_unless(23701, ($ctx'value >= $self'launchFee));
        slice $creator = $ctx'sender;
        $self'launchCount = ($self'launchCount + 1);
        $global_send($SendParameters$_constructor_to_value_mode_body($self'platformTreasury, $self'launchFee, 1, __gen_cell_cell_7211a724f87fe99325b74b7957e2198566501586c02e85b877c5e33fea305adb()));
        var ($curveInit'code, $curveInit'data) = $BondingCurve$_init_child($creator, $self'platformTreasury, $global_myAddress(), $msg'name, $msg'symbol);
        $global_send($SendParameters$_constructor_to_value_mode_code_data_body($global_contractAddress(($curveInit'code, $curveInit'data)), 100000000, 1, $curveInit'code, $curveInit'data, __gen_cell_cell_33a5f8926958fea19f3d5fbb898977b076fc32f951dd2dfc4a22b1b389b22dff()));
        if (($msg'initialBuyTon > 0)) {
            $global_send($SendParameters$_constructor_to_value_mode_body($global_contractAddress(($curveInit'code, $curveInit'data)), $msg'initialBuyTon, 1, $Buy$_store_cell($Buy$_constructor_queryId_minTokensOut($msg'queryId, 0), begin_cell())));
        }
        int $remaining = ((($ctx'value - $self'launchFee) - 150000000) - $msg'initialBuyTon);
        if (($remaining > 0)) {
            $global_send($SendParameters$_constructor_to_value_mode_body($creator, $remaining, 1, __gen_cell_cell_b0ff00cda639475b5e711360e99508a2790d5ee34d0598e7d8066850f3ac6c11()));
        }
        $LaunchpadFactory$_contract_store(($self'owner, $self'platformTreasury, $self'launchCount, $self'launchFee));
        return ();
    }
    
    ;; Throw if not handled
    throw(130);
}


() __tact_selector_hack_asm() impure asm """
@atend @ 1 {
        execute current@ context@ current!
        {
            // The core idea of this function is to save gas by avoiding unnecessary dict jump, when recv_internal/recv_external is called
            // We want to extract recv_internal/recv_external from the dict and select needed function
            // not by jumping to the needed function by it's index, but by using usual IF statements.

            }END> b> // Close previous builder, now we have a cell of previous code on top of the stack

            <{ // Start of the new code builder
                SETCP0
                // Swap the new code builder with the previous code, now we have previous code on top of the stack
                swap
                // Transform cell to slice and load first ref from the previous code, now we have the dict on top of the stack
                <s ref@

                // Extract the recv_internal from the dict
                dup 0 swap @procdictkeylen idict@ { "internal shortcut error" abort } ifnot
                swap

                // Delete the recv_internal from the dict
                0 swap @procdictkeylen idict- drop
                // Delete the recv_external from the dict (it's okay if it's not there)
                -1 swap @procdictkeylen idict- drop
                // Delete the __tact_selector_hack from the dict
                65535 swap @procdictkeylen idict- drop

                // Bring the code builder from the bottom of the stack
                // because if recv_external extraction is optional, and the number of elements on the stack is not fixed
                depth 1- roll
                // Swap with the dict from which we extracted recv_internal and (maybe) recv_external
                swap

                // Check if the dict is empty
                dup null?
                // Store a copy of this flag in the bottom of the stack
                dup depth 1- -roll
                {
                    // If the dict is empty, just drop it (it will be null if it's empty)
                    drop
                }
                {
                    // If the dict is not empty, prepare continuation to be stored in c3
                    <{
                        // Save this dict as first ref in this continuation, it will be pushed in runtime by DICTPUSHCONST
                        swap @procdictkeylen DICTPUSHCONST
                        // Jump to the needed function by it's index
                        DICTIGETJMPZ
                        // If such key is not found, throw 11 along with the key as an argument
                        11 THROWARG
                    }> PUSHCONT
                    // Store the continuation in c3
                    c3 POP
                } cond

                // Function id is on top of the (runtime) stack
                DUP IFNOTJMP:<{
                    // place recv_internal here
                    DROP swap @addop
                }>

                // Bring back the flag, indicating if the dict is empty or not from the bottom of the stack
                depth 1- roll
                {
                    // If the dict is empty, throw 11
                    11 THROWARG
                }
                {
                    // If the dict is not empty, jump to continuation from c3
                    c3 PUSH JMPX
                } cond
            }> b>
        } : }END>c
        current@ context! current!
    } does @atend !
""";

() __tact_selector_hack() method_id(65535) {
    return __tact_selector_hack_asm();
}