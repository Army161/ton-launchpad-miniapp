builder $Buy$_store(builder build_0, (int, int) v) inline {
    var (v'queryId, v'minTokensOut) = v;
    build_0 = store_uint(build_0, 2, 32);
    build_0 = build_0.store_uint(v'queryId, 64);
    build_0 = build_0.store_varuint16(v'minTokensOut);
