;; Routing of a Contract BondingCurve
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'creator, $self'platformTreasury, $self'jettonMaster, $self'name, $self'symbol, $self'virtualTon, $self'virtualTokens, $self'realTonRaised, $self'tokensSold, $self'graduated, $self'totalCreatorFees, $self'totalPlatformFees) = $BondingCurve$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    var op = in_msg~load_opcode_internal();
    ;; Receive Buy message
    if (op == 0x2) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'minTokensOut = in_msg~load_varuint16();
        throw_unless(47764, (~ $self'graduated));
        var ($ctx'bounceable, $ctx'sender, $ctx'value, $ctx'raw) = __tact_context_get();
        int $tonIn = $ctx'value;
        throw_unless(23306, ($tonIn > 0));
        int $fee = (($tonIn * 200) / 10000);
        int $creatorFee = (($fee * 6000) / 10000);
        int $platformFee = ($fee - $creatorFee);
        int $tonAfterFee = ($tonIn - $fee);
        int $k = ($self'virtualTon * $self'virtualTokens);
        int $newVirtualTon = ($self'virtualTon + $tonAfterFee);
        int $newVirtualTokens = ($k / $newVirtualTon);
        int $tokensOut = ($self'virtualTokens - $newVirtualTokens);
        throw_unless(41529, ($tokensOut >= $msg'minTokensOut));
        throw_unless(14335, (($self'tokensSold + $tokensOut) <= 1000000000000000000));
        $self'virtualTon = $newVirtualTon;
        $self'virtualTokens = $newVirtualTokens;
        $self'tokensSold = ($self'tokensSold + $tokensOut);
        $self'realTonRaised = ($self'realTonRaised + $tonAfterFee);
        $self'totalCreatorFees = ($self'totalCreatorFees + $creatorFee);
        $self'totalPlatformFees = ($self'totalPlatformFees + $platformFee);
        if (($creatorFee > 0)) {
            $global_send($SendParameters$_constructor_to_value_mode_body($self'creator, $creatorFee, 1, __gen_cell_cell_1bb86bea460178a7dbdd746c2fda56cc412c99dd7588f7c46d8af98c62c55f93()));
        }
        if (($platformFee > 0)) {
            $global_send($SendParameters$_constructor_to_value_mode_body($self'platformTreasury, $platformFee, 1, __gen_cell_cell_4c918c5cb130605c7adb49ce72ee5218703af9cb6ea130e487009609c6deabfa()));
        }
        int $gasLeft = $global_myBalance();
        if (($gasLeft > 10000000)) {
            $global_send($SendParameters$_constructor_to_value_mode_body($ctx'sender, ($gasLeft - 5000000), 1, __gen_cell_cell_5e6a9d6d45920957f1f6a1c0c189c20ae2a4689329ee9e2c9cc883fc5423b1a9()));
        }
        if (($self'realTonRaised >= 1500000000000)) {
            $self'graduated = true;
        }
        $BondingCurve$_contract_store(($self'creator, $self'platformTreasury, $self'jettonMaster, $self'name, $self'symbol, $self'virtualTon, $self'virtualTokens, $self'realTonRaised, $self'tokensSold, $self'graduated, $self'totalCreatorFees, $self'totalPlatformFees));
        return ();
    }
    
    ;; Receive JettonTransferNotification message
    if (op == 0x6) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_varuint16();
        var $msg'sender = in_msg~load_msg_addr();
        var $msg'forwardPayload = in_msg;
        var ($ctx'bounceable, $ctx'sender, $ctx'value, $ctx'raw) = __tact_context_get();
        throw_unless(47764, (~ $self'graduated));
        throw_unless(4429, ( equal_slices_bits($msg'sender, $ctx'sender) ));
        int $tokenIn = $msg'amount;
        int $k = ($self'virtualTon * $self'virtualTokens);
        int $newVirtualTokens = ($self'virtualTokens + $tokenIn);
        int $newVirtualTon = ($k / $newVirtualTokens);
        int $tonOut = ($self'virtualTon - $newVirtualTon);
        int $fee = (($tonOut * 200) / 10000);
        int $creatorFee = (($fee * 6000) / 10000);
        int $platformFee = ($fee - $creatorFee);
        int $tonAfterFee = ($tonOut - $fee);
        throw_unless(41529, ($tonAfterFee >= $msg'forwardPayload~$Slice$_fun_loadCoins()));
        $self'virtualTon = $newVirtualTon;
        $self'virtualTokens = $newVirtualTokens;
        $self'tokensSold = ($self'tokensSold - $tokenIn);
        $self'realTonRaised = ($self'realTonRaised - $tonOut);
        $self'totalCreatorFees = ($self'totalCreatorFees + $creatorFee);
        $self'totalPlatformFees = ($self'totalPlatformFees + $platformFee);
        if (($creatorFee > 0)) {
            $global_send($SendParameters$_constructor_to_value_mode_body($self'creator, $creatorFee, 1, __gen_cell_cell_1bb86bea460178a7dbdd746c2fda56cc412c99dd7588f7c46d8af98c62c55f93()));
        }
        if (($platformFee > 0)) {
            $global_send($SendParameters$_constructor_to_value_mode_body($self'platformTreasury, $platformFee, 1, __gen_cell_cell_4c918c5cb130605c7adb49ce72ee5218703af9cb6ea130e487009609c6deabfa()));
        }
        $global_send($SendParameters$_constructor_to_value_mode_body($msg'sender, $tonAfterFee, 1, __gen_cell_cell_c49413a7f64622c11467b481c819c1364d2476c295815cc38a28af57fecf0f60()));
        $BondingCurve$_contract_store(($self'creator, $self'platformTreasury, $self'jettonMaster, $self'name, $self'symbol, $self'virtualTon, $self'virtualTokens, $self'realTonRaised, $self'tokensSold, $self'graduated, $self'totalCreatorFees, $self'totalPlatformFees));
        return ();
    }
    
    ;; Receive Graduate message
    if (op == 0x4) {
        var $msg'queryId = in_msg~load_uint(64);
        throw_unless(47764, (~ $self'graduated));
        throw_unless(42433, ($self'realTonRaised >= 1500000000000));
        $self'graduated = true;
        $BondingCurve$_contract_store(($self'creator, $self'platformTreasury, $self'jettonMaster, $self'name, $self'symbol, $self'virtualTon, $self'virtualTokens, $self'realTonRaised, $self'tokensSold, $self'graduated, $self'totalCreatorFees, $self'totalPlatformFees));
        return ();
    }
    
    ;; Throw if not handled
    throw(130);
}


() __tact_selector_hack_asm() impure asm """
@atend @ 1 {
        execute current@ context@ current!
        {
            // The core idea of this function is to save gas by avoiding unnecessary dict jump, when recv_internal/recv_external is called
            // We want to extract recv_internal/recv_external from the dict and select needed function
            // not by jumping to the needed function by it's index, but by using usual IF statements.

            }END> b> // Close previous builder, now we have a cell of previous code on top of the stack

            <{ // Start of the new code builder
                SETCP0
                // Swap the new code builder with the previous code, now we have previous code on top of the stack
                swap
                // Transform cell to slice and load first ref from the previous code, now we have the dict on top of the stack
                <s ref@

                // Extract the recv_internal from the dict
                dup 0 swap @procdictkeylen idict@ { "internal shortcut error" abort } ifnot
                swap

                // Delete the recv_internal from the dict
                0 swap @procdictkeylen idict- drop
                // Delete the recv_external from the dict (it's okay if it's not there)
                -1 swap @procdictkeylen idict- drop
                // Delete the __tact_selector_hack from the dict
                65535 swap @procdictkeylen idict- drop

                // Bring the code builder from the bottom of the stack
                // because if recv_external extraction is optional, and the number of elements on the stack is not fixed
                depth 1- roll
                // Swap with the dict from which we extracted recv_internal and (maybe) recv_external
                swap

                // Check if the dict is empty
                dup null?
                // Store a copy of this flag in the bottom of the stack
                dup depth 1- -roll
                {
                    // If the dict is empty, just drop it (it will be null if it's empty)
                    drop
                }
                {
                    // If the dict is not empty, prepare continuation to be stored in c3
                    <{
                        // Save this dict as first ref in this continuation, it will be pushed in runtime by DICTPUSHCONST
                        swap @procdictkeylen DICTPUSHCONST
                        // Jump to the needed function by it's index
                        DICTIGETJMPZ
                        // If such key is not found, throw 11 along with the key as an argument
                        11 THROWARG
                    }> PUSHCONT
                    // Store the continuation in c3
                    c3 POP
                } cond

                // Function id is on top of the (runtime) stack
                DUP IFNOTJMP:<{
                    // place recv_internal here
                    DROP swap @addop
                }>

                // Bring back the flag, indicating if the dict is empty or not from the bottom of the stack
                depth 1- roll
                {
                    // If the dict is empty, throw 11
                    11 THROWARG
                }
                {
                    // If the dict is not empty, jump to continuation from c3
                    c3 PUSH JMPX
                } cond
            }> b>
        } : }END>c
        current@ context! current!
    } does @atend !
""";

() __tact_selector_hack() method_id(65535) {
    return __tact_selector_hack_asm();
}